<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kelepiravi" parent="android:Theme.Material.Light.NoActionBar" />
    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">#121212</item>
        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.Kelepiravi</item>
    </style>
</resources>
